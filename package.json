{
  "name": "agenda-citas",
  "version": "0.38.49",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run db:migrate:prod && opennextjs-cloudflare build && node scripts/limpiar-env-del-bundle.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integracion": "vitest run --project integracion",
    "verificar": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node --env-file=.env.production.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "drizzle-kit check",
    "db:semilla": "tsx --conditions=react-server scripts/semilla.ts",
    "db:semilla:prod": "node --env-file=.env.production.local --conditions=react-server --import tsx scripts/semilla.ts"
  },
  "dependencies": {
    "@clerk/localizations": "4.23.0",
    "@clerk/nextjs": "7.9.15",
    "@date-fns/tz": "1.5.0",
    "@neondatabase/serverless": "1.2.0",
    "@opennextjs/cloudflare": "1.20.9",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
