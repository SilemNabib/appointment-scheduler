# Plantilla de variables de entorno (ARCH §7.7 y §21.3). Solo nombres, sin valores.
#
# Dónde va cada valor (nunca en un archivo versionado, RNF-04):
#   - Desarrollo: .env.local (next dev y scripts) y .dev.vars (npm run preview).
#   - Producción: secretos del Worker (`npx wrangler secret put`), `vars` de
#     wrangler.jsonc y, para las variables de build y las migraciones,
#     .env.production.local (Q-06, Q-07).

# ─── Base de datos: Neon (ARCH §8) ────────────────────────────────────────────
# Secreto del Worker. Endpoint con pooler.
DATABASE_URL=
# Solo local y CI. Cadena directa (sin pooler) para las migraciones.
DATABASE_URL_DIRECTA=
# Solo local. API de Neon para las ramas efímeras de las pruebas de integración (Q-07).
NEON_API_KEY=
NEON_PROJECT_ID=

# ─── Clerk (ARCH §7.7) ────────────────────────────────────────────────────────
# Variable de build. Clave pública.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secreto del Worker. API de backend (invitaciones, currentUser).
CLERK_SECRET_KEY=
# Variables de build: /login y /registro.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Variable del Worker. IDs user_… del admin del SaaS, separados por comas (ADR-07).
SUPERADMIN_CLERK_USER_IDS=

# ─── Correo: Resend (ARCH §14) ────────────────────────────────────────────────
# Secreto del Worker.
RESEND_API_KEY=
# Variables del Worker: remitente de los correos de citas (citas@…), remitente de
# C-07 y C-08 (cuenta@…) y destino de las respuestas a C-07 y C-08.
CORREO_REMITENTE=
CORREO_CUENTA=
CORREO_SOPORTE=

# ─── Firmas (ARCH §13 y §14.7) ────────────────────────────────────────────────
# Secretos del Worker. _ANTERIOR solo durante la rotación del secreto (§13).
GESTION_CITA_SECRET=
GESTION_CITA_SECRET_ANTERIOR=
CALENDARIO_SECRET=

# ─── Worker ───────────────────────────────────────────────────────────────────
# Secreto del Worker. Authorization: Bearer de la ruta interna del cron (§14.5).
CRON_SECRET=
# Variable del Worker. URL base para los links absolutos de los correos.
APP_URL=
