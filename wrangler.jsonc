// Basado en ARCH §21.2, reducido a lo que usa la Fase 1.
// R2 (`r2_buckets`) y los límites de frecuencia (`ratelimits`) se añaden en la
// fase que los usa.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenda-citas",
  "main": "worker.ts", // §14.5
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "triggers": { "crons": ["*/5 * * * *"] }, // RN-21; manejador `scheduled` de worker.ts (§14.5)
  // Variables del Worker que no son secretas (ARCH §21.3). Los secretos (DATABASE_URL,
  // CLERK_SECRET_KEY y CRON_SECRET) se cargan con `wrangler secret put`. En `npm run
  // preview`, .dev.vars las reemplaza.
  "vars": {
    "APP_URL": "https://agenda-citas.silemnabib.workers.dev", // Q-06: *.workers.dev hasta la Fase 9
    "SUPERADMIN_CLERK_USER_IDS": "user_3KhaunZa71brNOGSPViLEHeGABo" // ADR-07; instancia de desarrollo de Clerk (Q-06)
  },
  "observability": { "enabled": true }
}
